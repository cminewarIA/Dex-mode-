# /etc/udev/rules.d/99-lapdock-devices.rules
# Lapdock OS - Reglas de detección automática de hardware

# 1. Permisos globales USB para demonio ADB sin root
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", MODE="0666", GROUP="plugdev", TAG+="systemd"

# 2. Terminales Android reconocidos (Samsung Galaxy, Google Pixel, Xiaomi, Motorola, etc.) y Ubuntu Touch
# 04e8=Samsung, 18d1=Google, 2717=Xiaomi, 22b8=Motorola, 0bb4=HTC, 12d1=Huawei, 05c6=Qualcomm, 2a70=OnePlus, 19d2=ZTE, 0e8d=MediaTek, 0b05=ASUS, 1004=LG, 2b4c=Volla, 2a47=BQ
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8|18d1|2717|22b8|0bb4|12d1|05c6|2a70|19d2|0e8d|0b05|1004|2b4c|2a47|2931|17ef|04b3", MODE="0666", GROUP="plugdev", TAG+="systemd"

# 3. Dispositivos de vídeo V4L2 (Captura de vídeo y cámaras UVC)
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", MODE="0666", GROUP="video", TAG+="systemd"

# 4. Emulación de periféricos UHID y UINPUT (Scrcpy teclado y ratón nativos por hardware)
KERNEL=="uhid", MODE="0666", GROUP="input"
KERNEL=="uinput", MODE="0666", GROUP="input"

