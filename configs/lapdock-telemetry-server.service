[Unit]
Description=Lapdock OS Central Telemetry & Log Server
After=network.target

[Service]
Type=simple
User=servidor
Group=servidor
WorkingDirectory=/home/servidor/almacenamiento/proyectos agy/modo DEx
ExecStart=/usr/bin/python3 "/home/servidor/almacenamiento/proyectos agy/modo DEx/scripts/lapdock-telemetry-server.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
